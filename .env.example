# Cloud sync + dashboard web (opcional) — copie para ".env" e preencha
# com os dados do seu projeto Supabase (Project Settings → API) e a URL
# do dashboard depois de fazer o deploy na Vercel.
#
# Sem esse arquivo a extensão builda e funciona normalmente, só sem a
# barra de sincronização (o popup fica idêntico a antes).

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica
VITE_DASHBOARD_URL=https://seu-dashboard.vercel.app
